# ---------------------------------------------------------------------------
# Core — copy this file to .env and fill in the values before deploying.
# Never commit .env to GitHub.
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
ALLOWED_HOSTS=kerichodaily.co.ke,www.kerichodaily.co.ke
CSRF_TRUSTED_ORIGINS=https://kerichodaily.co.ke,https://www.kerichodaily.co.ke
SITE_URL=https://kerichodaily.co.ke
SITE_NAME=KERICHO DAILY
SITE_TAGLINE=Your Trusted Source. Your Daily News.
SITE_EMAIL=newsroom@kerichodaily.co.ke
SITE_PHONE=+254 700 000 000

# Public admin path (change this to something only your team knows)
ADMIN_URL=admin/

# Site-wide demo banner. Keep 0 in production.
# Article-level "Sample report" labels are controlled by each article, not this flag.
SHOW_DEMO_BANNER=0

# Optional security overrides (defaults shown)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Database — leave DB_NAME blank to use the local SQLite file.
# ---------------------------------------------------------------------------
DB_NAME=kericho_daily
DB_USER=kericho_daily
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Caching and email
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=newsletter@kerichodaily.co.ke
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=newsroom@kerichodaily.co.ke
NEWSLETTER_FROM_EMAIL=newsroom@kerichodaily.co.ke

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
GOOGLE_AD_MANAGER_ID=XXXXXXXXXX
SEARCH_CONSOLE_VERIFICATION=your-verification-token

# ---------------------------------------------------------------------------
# Social
# ---------------------------------------------------------------------------
FACEBOOK_URL=https://facebook.com/kerichodaily
X_URL=https://x.com/kerichodaily
INSTAGRAM_URL=https://instagram.com/kerichodaily
YOUTUBE_URL=https://youtube.com/@kerichodaily
WHATSAPP_URL=https://wa.me/254700000000
